# Google Sheets (Sheet A) — service-account auth via google-auth + gspread.
GOOGLE_SERVICE_ACCOUNT_KEY=/path/to/service-account.json
GOOGLE_SHEETS_SPREADSHEET_ID=1rE1m9s2Y9_a1rE1m9s2Y9_a1rE1m9s2Y9_a1rE1m9s2Y9_a1
GOOGLE_SHEETS_SHEET_NAME=Sheet1

# Telegram — Bot API only, long polling via getUpdates.
TELEGRAM_BOT_TOKEN=1234567890:ABC-DEF1234567890
TELEGRAM_CHAT_ID=1234567890

# Local state file (mounted volume in the container).
STATE_FILE_PATH=/data/state.json

# Process tuning (optional — sane defaults apply if unset).
WORKER_COUNT=1
TELEGRAM_POLL_TIMEOUT=30
# LOG_LEVEL=INFO

# OpenRouter LLM fallback for Threads field extraction (all optional).
# When OPENROUTER_API_KEY is unset, regex-only extraction is used.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-oss-20b:free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
